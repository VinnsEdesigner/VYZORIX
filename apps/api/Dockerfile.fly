# =============================================================================
# Vyzorix — Go server only (no frontend, no SSR)
#
# This is the image Fly builds. The multi-stage apps/api/Dockerfile also builds
# the React dashboard and an SSR server; that stage installs a full Node/pnpm
# toolchain and is slow to build, and none of it is needed to run the API.
# This image is just the Go binary and its runtime dependencies, so the build is
# minutes shorter and the image is far smaller.
#
# The API is complete: every /v1 route, the WebSocket, GraphQL, the deploy
# surface and the OTA endpoints. What is absent is the dashboard's static assets,
# so GET / serves nothing. Point a browser at the API's own routes instead.
# =============================================================================
# syntax=docker/dockerfile:1.7-labs

# -----------------------------------------------------------------------------
# Stage 1: build the Go binary
# -----------------------------------------------------------------------------
FROM golang:1.27.3 AS go-builder

WORKDIR /app

# Dependencies first, for layer caching: go.mod/go.sum change far less often
# than the source, so this layer survives most rebuilds.
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download

COPY apps/api ./

# CGO is on because the SQLite backend (mattn/go-sqlite3) needs it; the Turso
# backend is pure Go, but the binary is built once and both backends must work.
RUN CGO_ENABLED=1 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/vyzorix ./cmd/api

# -----------------------------------------------------------------------------
# Stage 2: runtime
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS production

# ca-certificates: every outbound HTTPS call (Turso, Resend, GitHub, FCM).
# curl: the HEALTHCHECK below, and Fly's own checks.
# tzdata: correct timestamps in logs and audit rows.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

# Non-root. The app writes only to /data, so this needs no extra privileges.
RUN useradd -m -s /bin/bash appuser

LABEL org.opencontainers.image.title="Vyzorix" \
      org.opencontainers.image.description="Vyzorix device management and deploy server" \
      org.opencontainers.image.vendor="Vyzorix"

WORKDIR /app

ENV PORT=3000 \
    NODE_ENV=production \
    BIND_ADDR=0.0.0.0 \
    VYZORIX_API_DIR=/data \
    VYZORIX_BIN_DIR=/app/bin \
    VYZORIX_PUBLIC_DIR=/app/public \
    PATH=/app/bin:/usr/local/bin:$PATH

# /data is where version.json and any local state live; /app/bin is where the
# published APK is staged; /app/public is the (empty) static-asset directory.
RUN mkdir -p /data /app/bin /app/public /app/logs && \
    chown -R appuser:appuser /app /data

COPY --from=go-builder --chown=appuser:appuser /out/vyzorix /app/vyzorix

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

USER appuser

ENTRYPOINT ["/app/vyzorix"]
