[Unit]
Description=Vyzorix proxy (BFF: serves the web app, holds the session, signs API calls)
Documentation=https://github.com/VinnsEdesigner/VYZORIX
After=network-online.target vyzorix-api.service
Wants=network-online.target
# Start with the API, but do not stop when it restarts: the proxy serves the
# shell and the login page from its own bundle, and its 502s recover on their own
# once the API is back.
Requires=vyzorix-api.service

[Service]
Type=simple
User=vyzorix
Group=vyzorix
WorkingDirectory=/opt/vyzorix/apps/proxy-server
EnvironmentFile=/etc/vyzorix/proxy.env
ExecStart=/usr/bin/node /opt/vyzorix/apps/proxy-server/vyzorix-proxy-server.cjs

# The proxy closes its listener and flushes persisted sessions on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

# The proxy owns the web build (read-only) and its session store (writable).
# PROXY_SESSION_FILE in /etc/vyzorix/proxy.env must point inside this path, or
# every restart signs every user out.
ReadWritePaths=/var/lib/vyzorix/proxy

LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vyzorix-proxy

[Install]
WantedBy=multi-user.target
