# /etc/vyzorix/api.env — environment for vyzorix-api.service
#
# Mode 0640, owner root:vyzorix. The file holds signing keys and tokens.
# Generate each secret with: openssl rand -hex 32

NODE_ENV=production
PORT=3000

# Bind loopback only. The proxy is the sole client; nothing else should reach the
# API port directly. Behind Docker or a separate host, set this to the address the
# proxy can reach instead.
BIND_ADDR=127.0.0.1

DATABASE_BACKEND=sqlite
DATABASE_URL=/var/lib/vyzorix/vyzorix.db
VYZORIX_API_DIR=/var/lib/vyzorix
VYZORIX_PUBLIC_DIR=/var/lib/vyzorix
VYZORIX_BIN_DIR=/opt/vyzorix/bin

# The browser talks to the proxy, never to the API. Signature verification is
# what makes that meaningful: the proxy signs, the API verifies.
ENFORCE_HMAC=true
ALLOWED_ORIGINS=https://your-domain.example

BASE_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
AUTO_OPEN_BROWSER=false

# Trust the proxy's X-Forwarded-For so the session row records the real client IP
# (shown on the profile page). Set to the proxy's address.
TRUSTED_PROXIES=127.0.0.1,::1

RATE_LIMIT_REQUESTS=1000
AUTH_RATE_LIMIT_REQUESTS=100

# --- Secrets: replace every value below. ---
API_KEY_primary=CHANGE_ME
SERVER_API_TOKEN=CHANGE_ME
JWT_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME

# --- Web push (optional; leave blank to disable) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@your-domain.example
