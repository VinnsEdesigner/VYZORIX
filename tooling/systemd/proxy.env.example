# /etc/vyzorix/proxy.env — environment for vyzorix-proxy.service
#
# Mode 0640, owner root:vyzorix.

NODE_ENV=production

# Public port. Put nginx or the platform's TLS terminator in front of it.
PROXY_PORT=12000
API_TARGET=http://127.0.0.1:3000

# Where the built web app lives (dist/client and dist/server beside it).
WEB_APP_DIR=/opt/vyzorix/apps/VyzoriX_web

# Persist sessions across restarts. Without this every deploy signs every user
# out. The file holds signing keys and tokens and is written 0600, so it must sit
# inside the unit's ReadWritePaths.
PROXY_SESSION_FILE=/var/lib/vyzorix/proxy/proxy-sessions.json

PROXY_SIGN=true
PROXY_STRIP_SIGNING_KEY=true
PROXY_VERBOSE=false
